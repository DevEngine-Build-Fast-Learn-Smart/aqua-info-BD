{
  "name": "aqua-info-bd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src tests *.ts *.json index.html README.md ASSETS.md",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md ASSETS.md",
    "dev:full": "node scripts/dev.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
